<Project Sdk="Microsoft.NET.Sdk">
  <!-- Opt-in AI features: DescriptionEnhancer (rewriting descriptions through an IChatClient) and
       embedding search (IEmbeddingGenerator plus in-memory cosine similarity).
       The dependency on Microsoft.Extensions.AI is confined to this project. When nothing is
       configured the pipeline passes spec text through unchanged, so the guarantee that McpSense
       works fully without AI must not be broken. -->
  <PropertyGroup>
    <Description>Opt-in AI enhancements for McpSense: LLM-rewritten tool descriptions and embedding-based semantic search over operations.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)" />
    <!-- Logging abstractions only: the enhancer reports what it rewrote and what it could not. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\McpSense.Core\McpSense.Core.csproj" />
  </ItemGroup>
</Project>
