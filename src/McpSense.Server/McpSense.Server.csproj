<Project Sdk="Microsoft.NET.Sdk">
  <!-- The MCP server itself: McpServerHandlers.ListToolsHandler and CallToolHandler are
       implemented by hand so that Tool objects (with an InputSchema JsonElement) can be built at
       run time. The high-level APIs (AIFunctionFactory, McpServerTool.Create) derive their schema
       from a compile-time delegate signature and therefore cannot be used here; see "important
       design constraints" in CLAUDE.md.
       AI is opt-in, so this project does not reference McpSense.Ai - McpSense.Tool wires the two
       together. -->
  <PropertyGroup>
    <!-- Not published: McpSense.Tool is the only package on NuGet, and it bundles this assembly,
         so a CLI user needs nothing else. Shipping this separately would freeze a public API that
         nobody has asked for yet; turning packing back on later is easy, unpublishing is not. -->
    <IsPackable>false</IsPackable>
    <Description>MCP server for McpSense: exposes an OpenAPI-derived tool catalog over stdio and dispatches tool calls to the upstream API.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <!-- ApiDispatcher is designed to be created through IHttpClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\McpSense.Core\McpSense.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="McpSense.Server.Tests" />
  </ItemGroup>
</Project>
