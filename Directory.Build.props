<Project>
  <!-- Settings shared by every project, following the conventions of line-openapi-dotnet. -->
  <PropertyGroup>
    <!-- Modern .NET only: a single net10.0 target. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- External dependency versions, managed in one place. McpSense runs no code generation, so
       unlike line-openapi-dotnet there is no lockstep constraint with generated output. -->
  <PropertyGroup>
    <!-- Spec parsing. Since 2.x the OpenAPI readers live in this single package
         (OpenApiDocument.LoadAsync returns a ReadResult). The old Microsoft.OpenApi.Readers
         package stopped at 2.0.0-preview9 and must not be used. -->
    <MicrosoftOpenApiVersion>3.10.2</MicrosoftOpenApiVersion>

    <!-- MCP C# SDK. Tools are served through McpServerHandlers.ListToolsHandler and
         CallToolHandler, reached via McpServerOptions.Handlers. -->
    <ModelContextProtocolVersion>2.2.0</ModelContextProtocolVersion>

    <!-- The dependency axis for the opt-in AI features. Only McpSense.Ai references it; Core and
         Server must not. Staying on Abstractions rather than the implementation/DI package keeps
         the dependency out of builds that never enable AI. -->
    <MicrosoftExtensionsAIVersion>10.10.0</MicrosoftExtensionsAIVersion>

    <!-- Hosting and Http ship together and are kept on one version. -->
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
    <CoconaVersion>2.2.0</CoconaVersion>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. PackageId defaults to the project name (= AssemblyName), so
       it is not set here; each .csproj supplies its own Description. -->
  <PropertyGroup>
    <Version>0.1.0-preview</Version>
    <Authors>pierre3</Authors>
    <Company>pierre3</Company>
    <Product>McpSense</Product>
    <Copyright>Copyright (c) pierre3</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pierre3/mcp-sense</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pierre3/mcp-sense</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;model-context-protocol;openapi;proxy;ai;llm;tools</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- SourceLink (bundled with the net10 SDK), deterministic builds and symbol packages. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Ship the repository README inside packable projects (the file PackageReadmeFile names).
       Projects with IsPackable=false are never packed, so this is harmless for them. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(PackRootReadme)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
