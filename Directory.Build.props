<Project>
  <!-- 全プロジェクト共通設定（line-openapi-dotnet の規約を踏襲）。 -->
  <PropertyGroup>
    <!-- サポート対象はモダン .NET のみ。net10.0 単一。 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 外部依存のバージョンを一元管理する。
       McpSense は Kiota のようなコード生成を行わないため、生成物とのロックステップ制約は無い。 -->
  <PropertyGroup>
    <!-- spec 解析。OpenAPI 3.0/3.1 の読み取り API（OpenApiDocument.LoadAsync → ReadResult）は
         2.x 以降この単一パッケージに統合済み。旧 Microsoft.OpenApi.Readers は 2.0.0-preview9 で
         更新が止まっており使用しない（Microsoft Learn の API リファレンスで確認）。 -->
    <MicrosoftOpenApiVersion>3.10.2</MicrosoftOpenApiVersion>

    <!-- MCP C# SDK。McpServerHandlers.ListToolsHandler / CallToolHandler を使う
         （McpServerOptions.Handlers 経由）。 -->
    <ModelContextProtocolVersion>2.2.0</ModelContextProtocolVersion>

    <!-- AI オプトイン機能の依存軸。McpSense.Ai だけが参照し、Core / Server は参照しない。
         実装/DI パッケージ（Microsoft.Extensions.AI）ではなく Abstractions に留めることで、
         AI 未使用時に不要な依存を持ち込まない。 -->
    <MicrosoftExtensionsAIVersion>10.10.0</MicrosoftExtensionsAIVersion>

    <MicrosoftExtensionsHostingVersion>10.0.0</MicrosoftExtensionsHostingVersion>
    <CoconaVersion>2.2.0</CoconaVersion>
  </PropertyGroup>

  <!-- NuGet パッケージ共通メタデータ。PackageId はプロジェクト名（=AssemblyName）から既定継承。
       個別の Description は各 .csproj で設定する。 -->
  <PropertyGroup>
    <Version>0.1.0-preview</Version>
    <Authors>pierre3</Authors>
    <Company>pierre3</Company>
    <Product>McpSense</Product>
    <Copyright>Copyright (c) pierre3</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pierre3/mcp-sense</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pierre3/mcp-sense</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;model-context-protocol;openapi;proxy;ai;llm;tools</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- SourceLink（net10 SDK 同梱）・決定的ビルド・シンボルパッケージ -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- パッケージ対象プロジェクトにルート README を同梱（PackageReadmeFile の実体）。
       テスト等 IsPackable=false のプロジェクトはパックされないため無害。 -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(PackRootReadme)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>
</Project>
